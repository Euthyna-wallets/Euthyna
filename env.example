# API / Guard
PORT=3000
GUARD_ED25519_PRIVATE_KEY_BASE64=
VENDOR_REGISTRY_PATH=config/clients/acme/vendors.json
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_RELAYER_ACCOUNT_ID=
NEAR_RELAYER_PRIVATE_KEY=
NEAR_ACCOUNT_PARENT=mandateos.testnet
AGENT_KEY_PATH=.mandateos/agent-key.json

# PostgreSQL (Better Auth + registries)
DATABASE_URL=postgresql://mandateos:mandateos@127.0.0.1:5432/mandateos

# Better Auth — generate a 32+ byte secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CONSOLE_ORIGIN=http://localhost:5173
# WebAuthn relying party; "localhost" for local development.
PASSKEY_RP_ID=localhost

# Console wallets: disabled by default. Enable only for explicit test-only UAT.
VITE_UAT_DEMO_MODE=0
# API counterpart: accepts an unfunded deterministic w-<sha256(pubkey)> proof.
UAT_DEMO_WALLETS_ENABLED=0

# Treasury onboarding
NEAR_AGENT_GAS_RESERVE_YOCTO=300000000000000000000000
NEAR_AGENT_GAS_LOW_YOCTO=50000000000000000000000
NEAR_SPONSOR_DAILY_WALLET_LIMIT=5
NEAR_SPONSOR_WALLET_AMOUNT_YOCTO=500000000000000000000000
DAO_FACTORY_ID=factory-v2.mandateos.testnet
DAO_CREATE_DEPOSIT_YOCTO=250000000000000000000000
DAO_GLOBAL_CODE_HASH=Ea8tHXFSQVszVwGASyzAfLq65DjcRDhkfab4FcPaRpgD
DAO_FACTORY_DEPOSIT_YOCTO=2000000000000000000000000
MPC_CONTRACT_ID=v1.signer-prod.testnet
BUDGET_TOKEN_ACCOUNT_ID=
CONTRACT_ARTIFACTS_DIR=contracts/res

# Separate payment worker (`pnpm --filter @mandateos/api worker`)
WORKER_POLL_INTERVAL_MS=5000
WORKER_CONFIRMATIONS=5
WORKER_LEASE_MS=20000
# NEAR blocks before an MPC/broadcast attempt is treated as stuck.
WORKER_STUCK_BLOCKS=120
WORKER_BROADCAST_TIMEOUT_MS=60000
WORKER_RETRY_BASE_MS=1000
WORKER_RETRY_MAX_MS=60000

# Base Sepolia deployment — script refuses to run without the confirmation literal.
BASE_DEPLOY_CONFIRM=DEPLOY_ACME_BASE_SEPOLIA
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Optional: enables the "production" environment with a 86 400 s Delay cooldown.
BASE_MAINNET_RPC_URL=
BASE_DEPLOYER_PRIVATE_KEY=
BASE_GAS_WALLET_PRIVATE_KEY=
BASE_GAS_WALLET_MIN_BALANCE_WEI=5000000000000000
COUNCIL_PRIVATE_KEY_1=
COUNCIL_PRIVATE_KEY_2=
COUNCIL_PRIVATE_KEY_3=
BASE_ALLOWED_RECIPIENT=
GOV_ADDRESS=
