# API / Guard
PORT=3000
GUARD_VISA_ED25519_PRIVATE_KEY_BASE64=
GUARD_STATUS_ED25519_PRIVATE_KEY_BASE64=
VENDOR_REGISTRY_PATH=config/clients/acme/vendors.json
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEAR_RELAYER_ACCOUNT_ID=
NEAR_RELAYER_PRIVATE_KEY=
# Vaults and agents are created under this account; it must be the relayer (empty = relayer).
NEAR_ACCOUNT_PARENT=
AGENT_KEY_PATH=.mandateos/agent-key.json

# PostgreSQL (Better Auth + registries)
DATABASE_URL=postgresql://mandateos:mandateos@127.0.0.1:5432/mandateos

# Better Auth — generate a 32+ byte secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CONSOLE_ORIGIN=http://localhost:5173
# WebAuthn relying party; "localhost" for local development.

# Console wallets: disabled by default. Enable only for explicit test-only UAT.
VITE_UAT_DEMO_MODE=0
# Lets dApps connect to the company wallet (reown.com project id; public)
VITE_WALLETCONNECT_PROJECT_ID=
# API counterpart: accepts an unfunded deterministic w-<sha256(pubkey)> proof
# and disables the in-memory registration throttle for this explicit UAT only.
UAT_DEMO_WALLETS_ENABLED=0

# Treasury onboarding
NEAR_AGENT_GAS_RESERVE_YOCTO=300000000000000000000000
NEAR_AGENT_GAS_LOW_YOCTO=50000000000000000000000
NEAR_SPONSOR_DAILY_WALLET_LIMIT=5
NEAR_SPONSOR_WALLET_AMOUNT_YOCTO=500000000000000000000000
# Company DAOs: official Sputnik factory (6 NEAR each, paid by the relayer)
DAO_FACTORY_ID=sputnikv2.testnet
DAO_CREATE_DEPOSIT_YOCTO=6000000000000000000000000
# Company vaults: created by Nomos from a published version (deposit read from vault_deposit)
NOMOS_ID=nomos.euthyna.testnet
DAO_GLOBAL_CODE_HASH=Ea8tHXFSQVszVwGASyzAfLq65DjcRDhkfab4FcPaRpgD
DAO_FACTORY_DEPOSIT_YOCTO=2000000000000000000000000
MPC_CONTRACT_ID=v1.signer-prod.testnet
BUDGET_TOKEN_ACCOUNT_ID=
CONTRACT_ARTIFACTS_DIR=contracts/res

# OmniRoles task 1a UAT
OMNIROLES_VISA_SECRET_HEX=
OMNIROLES_STATUS_SECRET_HEX=
OMNIROLES_WALLET_ADDRESS=
OMNIROLES_PAYMENT_RECIPIENT=
OMNIROLES_PAYMENT_AMOUNT=1000000
OMNIROLES_GAS_ETH=0.0001
OMNIROLES_MIN_GAS_WEI=50000000000000
OMNIROLES_BRIDGE_ETH=0.002
OMNIROLES_USE_DEV_ACCOUNT=0
OMNIROLES_TEST_USDC=2000000
# Console treasury (DAO + OmniRoles vault)
# Veto window before a voted rule applies (seconds, minimum 60)
OMNIROLES_RULE_DELAY_SECONDS=300
# Sputnik proposal bond (yocto): 0.1 NEAR
OMNIROLES_PROPOSAL_BOND_YOCTO=100000000000000000000000
BASE_TEST_USDC_ADDRESS=

# Separate payment worker (`pnpm --filter @mandateos/api worker`)
WORKER_POLL_INTERVAL_MS=5000
WORKER_CONFIRMATIONS=5
WORKER_LEASE_MS=20000
# Nominal NEAR block-seconds before an MPC/broadcast attempt is treated as stuck.
WORKER_STUCK_BLOCKS=120
WORKER_BROADCAST_TIMEOUT_MS=60000
WORKER_RETRY_BASE_MS=1000
WORKER_RETRY_MAX_MS=60000

# Base Sepolia deployment — script refuses to run without the confirmation literal.
BASE_DEPLOY_CONFIRM=DEPLOY_ACME_BASE_SEPOLIA
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Optional: enables the "production" environment with a 86 400 s Delay cooldown.
BASE_MAINNET_RPC_URL=
BASE_DEPLOYER_PRIVATE_KEY=
BASE_GAS_WALLET_PRIVATE_KEY=
BASE_GAS_WALLET_MIN_BALANCE_WEI=5000000000000000
# Dynamic Base quotes must remain below these governance caps.
BASE_TX_GAS_LIMIT_CAP=300000
BASE_TX_MAX_FEE_PER_GAS_CAP_WEI=100000000000
BASE_TX_MAX_PRIORITY_FEE_PER_GAS_CAP_WEI=10000000000
GOVERNANCE_MAX_FEE_FLOOR_WEI=100000000
COUNCIL_PRIVATE_KEY_1=
COUNCIL_PRIVATE_KEY_2=
COUNCIL_PRIVATE_KEY_3=
BASE_ALLOWED_RECIPIENT=
GOV_ADDRESS=

# Agent SDK + MCP + demo LLM
MANDATEOS_API_URL=http://localhost:3000
MANDATEOS_AGENT_API_KEY=
AGENT_NEAR_ACCOUNT_ID=
AGENT_KEY_PATH=.mandateos/agent-key.json
VAULT_ACCOUNT_ID=
AGENT_ROLE=researcher
EVM_CHAIN_ID=84532
DEMO_SCENARIO=payment-ok
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
DEMO_TOKEN=
DEMO_APPROVED_RECIPIENT=
DEMO_ATTACKER_RECIPIENT=
DEMO_AMOUNT=1000000
DEMO_GAS_LIMIT=200000
DEMO_MAX_FEE_PER_GAS=20000000000
DEMO_MAX_PRIORITY_FEE_PER_GAS=1000000000
# Bypass demo only: a prepared op and intentionally forged/old approval.
BYPASS_OP_ID=
BYPASS_APPROVAL_JSON=

# Shares: account funding (contract storage) and the NEP-141 shared as revenue next to NEAR.
OMNIROLES_SHARES_DEPOSIT_YOCTO=2900000000000000000000000
# Revenue epoch of new shares contracts (default: 3600 on testnet, 604800 elsewhere).
OMNIROLES_SHARES_EPOCH_SECONDS=3600
OMNIROLES_SHARES_REVENUE_TOKEN=base.omnidep.testnet

# Public HTTPS URL of the console and API on a server (e.g. https://euthyna.example.com).
# Leave empty for local runs on http://localhost:8088.
PUBLIC_URL=

# Euthyna Market (optional). A dedicated relayer that pays the gas of settled cheques:
# never the company relayer above. Fund it with a few NEAR; it holds no company funds.
# Rob the Agent (/v1/rob, docs/rob-the-agent.md): Ruggy's account and full-access key, the demo company, two suppliers of ours.
ROB_RUGGY_ACCOUNT_ID=
ROB_RUGGY_PRIVATE_KEY=
ROB_VAULT_ACCOUNT_ID=
ROB_DAO_ACCOUNT_ID=
ROB_SUPPLIERS=
# Rug O'Clock: an OpenAI-compatible LLM with tool calls (chat completions). Empty: falls back to LLM_* below;
# off (GET /v1/rob/rugoclock says enabled: false) unless a URL, a key and a model are set.
ROB_LLM_BASE_URL=https://cloud-api.near.ai/v1
ROB_LLM_API_KEY=
ROB_LLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
# Optional: the $LEASH testnet trophy (scripts/rob-leash.mjs deploys it). Empty: claims link plays, no trophy.
ROB_LEASH_TOKEN=
# Hire him: Ruggy's tx-check listing, delivered by the API itself (scripts/rob-hire-setup.mjs prints the token).
ROB_HIRE_HANDLE=ruggy-tx-check
ROB_HIRE_DELIVERY_TOKEN=
ROB_HIRE_DAILY_TOPUPS=100
ROB_HIRE_TOPUPS_PER_CLIENT=3
MARKET_RELAYER_ACCOUNT_ID=
MARKET_RELAYER_PRIVATE_KEY=
# At least 32 random characters; derives each listing's webhook signing key.
MARKET_WEBHOOK_SECRET=
MARKET_DAILY_SETTLEMENTS=200
MARKET_DAILY_PER_BUYER=20
# 1 only behind our own reverse proxy (rate limits then use its X-Forwarded-For hop).
MARKET_TRUST_PROXY=0
# Public URL of this API, as buyers reach it (A2A agent cards).
PUBLIC_API_URL=

# Founder seat recovery (ZK Email): the contract that verifies the proofs and runs the cancel window
# (contracts/email-recovery). Empty: euthyna-recovery.testnet on testnet.
RECOVERY_CONTRACT_ID=
# Testnet only: {"<selector>._domainkey.<domain>": "v=DKIM1; k=rsa; p=…"} for test mail domains.
RECOVERY_TEST_DKIM_KEYS=
