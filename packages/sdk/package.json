{
  "name": "@mandateos/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mandateos": "./dist/cli.js"
  },
  "scripts": {
    "agent:init": "tsx src/cli.ts agent init",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "near-api-js": "^5.1.1",
    "viem": "^2.30.6"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "vitest": "^3.2.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./roles": {
      "types": "./dist/roles.d.ts",
      "default": "./dist/roles.js"
    },
    "./solana": {
      "types": "./dist/solana.d.ts",
      "default": "./dist/solana.js"
    },
    "./email-proof": {
      "types": "./dist/email-proof.d.ts",
      "default": "./dist/email-proof.js"
    }
  }
}
