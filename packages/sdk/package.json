{
  "name": "@euthyna/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "euthyna": "./dist/cli.js"
  },
  "scripts": {
    "agent:init": "tsx src/cli.ts agent init",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aztec/bb.js": "5.3.0",
    "@noble/curves": "2.4.0",
    "@noir-lang/noir_js": "1.0.0-beta.26",
    "near-api-js": "^5.1.1",
    "viem": "^2.30.6"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "vitest": "^4.1.12"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./roles": {
      "types": "./dist/roles.d.ts",
      "default": "./dist/roles.js"
    },
    "./solana": {
      "types": "./dist/solana.d.ts",
      "default": "./dist/solana.js"
    },
    "./email-proof": {
      "types": "./dist/email-proof.d.ts",
      "default": "./dist/email-proof.js"
    },
    "./cheque": {
      "types": "./dist/cheque.d.ts",
      "default": "./dist/cheque.js"
    },
    "./tx-check": {
      "types": "./dist/tx-check.d.ts",
      "default": "./dist/tx-check.js"
    },
    "./bank-private": {
      "types": "./dist/bank-private.d.ts",
      "default": "./dist/bank-private.js"
    },
    "./sealed-orders": {
      "types": "./dist/sealed-orders.d.ts",
      "default": "./dist/sealed-orders.js"
    },
    "./agent-keys": {
      "types": "./dist/agent-keys.d.ts",
      "default": "./dist/agent-keys.js"
    },
    "./sealed-prover": {
      "types": "./dist/sealed-prover.d.ts",
      "default": "./dist/sealed-prover.js"
    },
    "./sealed-proof": {
      "types": "./dist/sealed-proof.d.ts",
      "default": "./dist/sealed-proof.js"
    },
    "./sealed-watcher": {
      "types": "./dist/sealed-watcher.d.ts",
      "default": "./dist/sealed-watcher.js"
    },
    "./sealed-agent": {
      "types": "./dist/sealed-agent.d.ts",
      "default": "./dist/sealed-agent.js"
    },
    "./circuits/sealed_order.json": "./circuits/sealed_order.json"
  }
}
