{
  "name": "@mandateos/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "DATABASE_URL=${DATABASE_URL:-postgresql://mandateos:mandateos@127.0.0.1:5432/mandateos} prisma generate && tsc -p tsconfig.json",
    "typecheck": "DATABASE_URL=${DATABASE_URL:-postgresql://mandateos:mandateos@127.0.0.1:5432/mandateos} prisma validate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://mandateos:mandateos@127.0.0.1:5432/mandateos} prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0"
  },
  "devDependencies": {
    "prisma": "^6.10.0"
  }
}
