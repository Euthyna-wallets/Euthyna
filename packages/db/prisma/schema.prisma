generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better Auth models (generated by `auth generate --adapter prisma`).
// `Apikey` maps to the `apikey` table and is addressed by the Prisma adapter
// through the `prisma.apikey` client property.
// ---------------------------------------------------------------------------

model User {
  id               String                  @id
  name             String
  email            String
  emailVerified    Boolean                 @default(false)
  image            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  sessions         Session[]
  accounts         Account[]
  members          Member[]
  invitations      Invitation[]
  agent            Agent?                  @relation("AgentIdentity")
  nearSponsorships NearWalletSponsorship[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                      String                           @id
  name                    String
  slug                    String
  logo                    String?
  createdAt               DateTime
  metadata                String?
  members                 Member[]
  invitations             Invitation[]
  agents                  Agent[]
  suppliers               Supplier[]
  consumedReferences      ConsumedReference[]
  registryChanges         RegistryChange[]
  visas                   PaymentVisa[]
  registry                RegistryVersion?
  operations              Operation[]
  auditLogs               AuditLog[]
  treasuries              Treasury[]
  nearSponsorships        NearWalletSponsorship[]
  agentProvisionings      AgentProvisioning[]
  agentPairings           AgentPairing[]
  marketListings          MarketListing[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id                      String                           @id
  organizationId          String
  organization            Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                    String                           @default("member")
  nearAccountId           String?
  evmAddress              String?
  walletProofClaimable    Boolean                          @default(false)
  walletProofVerifiedAt   DateTime?
  walletProofApprovedAt   DateTime?
  walletProofApprovedBy   String?
  walletProofMessage      String?
  nearProofPublicKey      String?
  nearProofSignature      String?
  evmProofSignature       String?
  createdAt               DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(60000)
  rateLimitMax        Int?      @default(60)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

// ---------------------------------------------------------------------------
// MandateOS models
// ---------------------------------------------------------------------------

model Agent {
  id             String             @id
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authUserId     String             @unique
  user           User               @relation("AgentIdentity", fields: [authUserId], references: [id], onDelete: Restrict)
  name           String
  role           String
  nearAccountId  String
  nearPublicKey  String
  vaultAccountId String
  mpcPath        String
  evmAddress     String?
  active         Boolean            @default(true)
  /// The console user who hired it: members may hire, and manage only their own hires.
  createdByUserId String?
  operations     Operation[]
  provisioning   AgentProvisioning?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, nearAccountId])
  @@index([organizationId])
  @@index([organizationId, createdByUserId])
  @@map("agent")
}

/// A one-time code that lets euthyna-signer hire an agent: the console makes it,
/// the signer redeems it with the agent's public key and receives its API key.
model AgentPairing {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId String
  name            String
  role            String
  nearAccountId   String
  vaultAccountId  String
  mpcPath         String
  /// sha256 of the code; the code itself is never stored.
  codeHash        String       @unique
  expiresAt       DateTime
  redeemedAt      DateTime?
  publicKey       String?
  hostname        String?
  agentId         String?
  createdAt       DateTime     @default(now())

  @@index([organizationId, createdByUserId])
  @@map("agent_pairing")
}

model Supplier {
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id             String           @id @default(uuid())
  name           String
  contact        String?
  active         Boolean          @default(true)
  wallets        SupplierWallet[]
  createdAt      DateTime         @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("supplier")
}

model SupplierWallet {
  id             String   @id @default(uuid())
  organizationId String
  supplierId     String
  chainId        Int
  address        String
  active         Boolean  @default(true)
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([organizationId, supplierId, chainId, address])
  @@index([organizationId, chainId, address])
  @@map("supplier_wallet")
}

model RegistryChange {
  id             String       @id @default(uuid())
  organizationId String
  kind           String
  payload        Json
  status         String       @default("pending")
  authorId       String
  reviewerId     String?
  createdAt      DateTime     @default(now())
  decidedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("registry_change")
}

model ConsumedReference {
  organizationId String
  reference      String
  opId           String
  consumedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, reference])
  @@index([organizationId, opId])
  @@map("consumed_reference")
}

model RegistryVersion {
  organizationId String       @id
  version        Int          @default(1)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("registry_version")
}

model PaymentVisa {
  organizationId String
  opId           String
  visa           Json
  signature      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, opId])
  @@map("payment_visa")
}

model WorkerLease {
  name      String   @id
  holder    String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@map("worker_lease")
}

model Operation {
  organizationId          String
  opId                    String
  /// Null for a transaction voted by the DAO (no agent behind it).
  agentId                 String?
  vaultAccountId          String?
  reference               String
  state                   String
  txDigest                String
  evmNonce                BigInt
  amount                  Decimal      @db.Decimal(78, 0)
  visaNonce               BigInt?
  reportNonce             BigInt?
  txHash                  String?
  cancellationTxHash      String?
  nearAuthorizationTxHash String?
  nearCancellationTxHash  String?
  receiptBlock            BigInt?
  broadcastAt             DateTime?
  cancellationRequestedAt DateTime?
  cancellationBroadcastAt DateTime?
  revertedAt              DateTime?
  lastAttemptAt           DateTime?
  nextAttemptAt           DateTime?
  attempts                Int          @default(0)
  lastError               String?
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent                   Agent?       @relation(fields: [agentId], references: [id], onDelete: Restrict)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@id([organizationId, opId])
  @@unique([organizationId, visaNonce])
  @@unique([organizationId, reportNonce])
  @@index([organizationId, reference])
  @@index([state, nextAttemptAt])
  @@map("operation")
}

model Treasury {
  id                   String                @id @default(uuid())
  organizationId       String
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environment          String                @default("uat")
  nearNetwork          String
  baseChainId          Int
  daoAccountId         String
  vaultAccountId       String
  vaultWasmSha256      String
  status               String                @default("active")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([organizationId, environment])
  @@index([organizationId])
  @@map("treasury")
}

model NearWalletSponsorship {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nearAccountId  String       @unique
  publicKey      String       @unique
  status         String       @default("reserved")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([createdAt, status])
  @@index([organizationId, userId])
  @@map("near_wallet_sponsorship")
}

model AgentProvisioning {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId         String       @unique
  agent           Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  nearAccountId   String       @unique
  publicKey       String       @unique
  vaultAccountId  String
  methodNames     Json
  reserveYocto    String
  allowanceYocto  String?
  status          String       @default("reserved")
  transactionHash String?
  confirmedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([createdAt, status])
  @@index([organizationId])
  @@map("agent_provisioning")
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorType      String
  actorId        String
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorType, actorId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Euthyna Market: listings, tasks, held payments (x402 v2 + NEP-366 cheques)
// ---------------------------------------------------------------------------

/// A service an AI company sells. Paid to its vault; the handle never changes.
model MarketListing {
  id                String         @id @default(uuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId           String?
  handle            String         @unique
  title             String
  description       String
  category          String         @default("research")
  /// Price in the asset's base units (1 USDC = 1000000).
  priceAtomic       String
  /// NEP-141 token account.
  asset             String
  /// The seller's vault account: the cheque pays it directly.
  payTo             String
  slaSeconds        Int            @default(1800)
  inputHint         String         @default("")
  outputHint        String         @default("")
  status            String         @default("draft") // draft | live | paused
  /// sha256 of the worker's delivery token (mdt_...), never the token itself.
  deliveryTokenHash String?        @unique
  /// Optional push to the worker (https only, public hosts only).
  webhookUrl        String?
  tasks             MarketTask[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([organizationId])
  @@index([status])
  @@map("market_listing")
}

model MarketTask {
  id             String         @id @default(uuid())
  listingId      String
  listing        MarketListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerAccountId String
  input          String
  /// submitted | working | completed | completed_unpaid | failed | expired
  state          String         @default("submitted")
  resultMarkdown String?
  resultJson     Json?
  files          Json?
  failureReason  String?
  hold           PaymentHold?
  rating         MarketRating?
  createdAt      DateTime       @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  /// Past this, an undelivered task expires and its cheque is never relayed.
  expiresAt      DateTime

  @@index([listingId, state])
  @@index([state, expiresAt])
  @@map("market_task")
}

/// The buyer's signed cheque, held until delivery, then relayed once.
model PaymentHold {
  id                String     @id @default(uuid())
  taskId            String     @unique
  task              MarketTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  signedDelegateB64 String
  /// sha256 of the signed message: a cheque is accepted once, ever.
  delegateHash      String     @unique
  sender            String
  publicKey         String
  nonce             String
  maxBlockHeight    String
  amount            String
  asset             String
  payTo             String
  /// held | settling | settled | failed | expired
  state             String     @default("held")
  /// "<sender>:<publicKey>" while held or settling, null after: one open cheque per buyer key.
  /// Two open cheques of one key could not both be paid (nonces), so a second is refused.
  openKey           String?    @unique
  settleTxHash      String?
  settleError       String?
  createdAt         DateTime   @default(now())
  settledAt         DateTime?

  @@index([state])
  @@index([sender])
  @@map("payment_hold")
}

model MarketRating {
  taskId    String     @id
  task      MarketTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stars     Int
  comment   String     @default("")
  createdAt DateTime   @default(now())

  @@map("market_rating")
}
