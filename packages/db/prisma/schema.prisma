generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better Auth models (generated by `auth generate --adapter prisma`).
// `Apikey` maps to the `apikey` table and is addressed by the Prisma adapter
// through the `prisma.apikey` client property.
// ---------------------------------------------------------------------------

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]
  members       Member[]
  invitations   Invitation[]
  agent         Agent?       @relation("AgentIdentity")

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Organization {
  id           String                  @id
  name         String
  slug         String
  logo         String?
  createdAt    DateTime
  metadata     String?
  members      Member[]
  invitations  Invitation[]
  environments OrganizationEnvironment[]
  agents       Agent[]
  vendors      Vendor[]
  policies     PolicySnapshot[]
  operations   Operation[]
  auditLogs    AuditLog[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(60000)
  rateLimitMax        Int?      @default(60)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

// ---------------------------------------------------------------------------
// MandateOS models
// ---------------------------------------------------------------------------

model OrganizationEnvironment {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environment    String
  nearNetwork    String
  baseChainId    Int
  vaultAccountId String?
  safeAddress    String?
  rolesAddress   String?
  delayAddress   String?

  @@id([organizationId, environment])
}

model Agent {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authUserId     String       @unique
  user           User         @relation("AgentIdentity", fields: [authUserId], references: [id], onDelete: Restrict)
  name           String
  role           String
  nearAccountId  String
  nearPublicKey  String
  vaultAccountId String
  mpcPath        String
  evmAddress     String?
  active         Boolean      @default(true)
  operations     Operation[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, nearAccountId])
  @@index([organizationId])
  @@map("agent")
}

model Vendor {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id             String
  name           String
  active         Boolean      @default(true)
  addresses      VendorAddress[]

  @@id([organizationId, id])
  @@map("vendor")
}

model VendorAddress {
  organizationId String
  vendorId       String
  chainId        Int
  address        String
  maximumPayment Decimal? @db.Decimal(78, 0)
  vendor         Vendor   @relation(fields: [organizationId, vendorId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, vendorId, chainId, address])
  @@unique([organizationId, chainId, address])
  @@map("vendor_address")
}

model PolicySnapshot {
  organizationId  String
  version         BigInt
  registryVersion BigInt
  status          String
  document        Json
  contentHash     String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@id([organizationId, version])
  @@unique([organizationId, contentHash])
  @@map("policy_snapshot")
}

model Operation {
  organizationId String
  opId           String
  agentId        String
  reference      String
  state          String
  txDigest       String
  evmNonce       BigInt
  amount         Decimal  @db.Decimal(78, 0)
  visaNonce      BigInt?
  reportNonce    BigInt?
  txHash         String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, opId])
  @@unique([organizationId, reference])
  @@unique([organizationId, visaNonce])
  @@unique([organizationId, reportNonce])
  @@map("operation")
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorType      String
  actorId        String
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorType, actorId])
  @@map("audit_log")
}
