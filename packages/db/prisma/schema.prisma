generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better Auth models (generated by `auth generate --adapter prisma`).
// `Apikey` maps to the `apikey` table and is addressed by the Prisma adapter
// through the `prisma.apikey` client property.
// ---------------------------------------------------------------------------

model User {
  id               String                  @id
  name             String
  email            String
  emailVerified    Boolean                 @default(false)
  image            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  sessions         Session[]
  accounts         Account[]
  passkeys         Passkey[]
  members          Member[]
  invitations      Invitation[]
  agent            Agent?                  @relation("AgentIdentity")
  nearSponsorships NearWalletSponsorship[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Organization {
  id                      String                           @id
  name                    String
  slug                    String
  logo                    String?
  createdAt               DateTime
  metadata                String?
  members                 Member[]
  invitations             Invitation[]
  environments            OrganizationEnvironment[]
  agents                  Agent[]
  suppliers               Supplier[]
  contracts               Contract[]
  consumedReferences      ConsumedReference[]
  registryChanges         RegistryChange[]
  escalations             Escalation[]
  visas                   PaymentVisa[]
  registry                RegistryVersion?
  policies                PolicySnapshot[]
  operations              Operation[]
  auditLogs               AuditLog[]
  treasuries              Treasury[]
  nearSponsorships        NearWalletSponsorship[]
  deploymentConfirmations TreasuryDeploymentConfirmation[]
  agentProvisionings      AgentProvisioning[]
  governanceOperations    GovernanceOperation[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id                      String                           @id
  organizationId          String
  organization            Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                    String                           @default("member")
  nearAccountId           String?
  evmAddress              String?
  walletProofClaimable    Boolean                          @default(false)
  walletProofVerifiedAt   DateTime?
  walletProofMessage      String?
  nearProofPublicKey      String?
  nearProofSignature      String?
  evmProofSignature       String?
  walletProofChallenges   WalletProofChallenge[]
  deploymentConfirmations TreasuryDeploymentConfirmation[]
  createdAt               DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model WalletProofChallenge {
  id            String    @id
  memberId      String
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  userId        String
  nearAccountId String
  evmAddress    String
  message       String
  nonceBase64   String
  recipient     String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([memberId])
  @@index([userId])
  @@map("wallet_proof_challenge")
}

model TreasuryDeploymentConfirmation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environment    String
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  digest         String
  confirmedAt    DateTime     @default(now())

  @@unique([organizationId, environment, memberId])
  @@index([organizationId, environment, digest])
  @@map("treasury_deployment_confirmation")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(60000)
  rateLimitMax        Int?      @default(60)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

// ---------------------------------------------------------------------------
// MandateOS models
// ---------------------------------------------------------------------------

model OrganizationEnvironment {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environment    String
  nearNetwork    String
  baseChainId    Int
  vaultAccountId String?
  safeAddress    String?
  rolesAddress   String?
  delayAddress   String?

  @@id([organizationId, environment])
}

model Agent {
  id             String             @id
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authUserId     String             @unique
  user           User               @relation("AgentIdentity", fields: [authUserId], references: [id], onDelete: Restrict)
  name           String
  role           String
  nearAccountId  String
  nearPublicKey  String
  vaultAccountId String
  mpcPath        String
  evmAddress     String?
  active         Boolean            @default(true)
  operations     Operation[]
  provisioning   AgentProvisioning?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, nearAccountId])
  @@index([organizationId])
  @@map("agent")
}

model Supplier {
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  id             String           @id @default(uuid())
  name           String
  contact        String?
  active         Boolean          @default(true)
  wallets        SupplierWallet[]
  contracts      Contract[]
  createdAt      DateTime         @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("supplier")
}

model SupplierWallet {
  id             String   @id @default(uuid())
  organizationId String
  supplierId     String
  chainId        Int
  address        String
  active         Boolean  @default(true)
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([organizationId, supplierId, chainId, address])
  @@index([organizationId, chainId, address])
  @@map("supplier_wallet")
}

model RegistryChange {
  id             String       @id @default(uuid())
  organizationId String
  kind           String
  payload        Json
  status         String       @default("pending")
  authorId       String
  reviewerId     String?
  createdAt      DateTime     @default(now())
  decidedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("registry_change")
}

model Contract {
  id             String       @id @default(uuid())
  organizationId String
  reference      String
  role           String
  supplierId     String
  maxAmount      Decimal      @db.Decimal(78, 0)
  periodicity    String
  token          String
  active         Boolean      @default(true)
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, reference])
  @@index([organizationId, role])
  @@map("contract")
}

model ConsumedReference {
  organizationId String
  reference      String
  opId           String
  consumedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, reference])
  @@index([organizationId, opId])
  @@map("consumed_reference")
}

model RegistryVersion {
  organizationId String       @id
  version        Int          @default(1)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("registry_version")
}

model Escalation {
  id               String       @id @default(uuid())
  organizationId   String
  opId             String
  agentId          String
  environment      String
  reasons          Json
  invoice          Json?
  registrySnapshot Json?
  status           String       @default("pending")
  decidedBy        String?
  createdAt        DateTime     @default(now())
  decidedAt        DateTime?
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, opId])
  @@index([organizationId, status])
  @@map("escalation")
}

model PaymentVisa {
  organizationId String
  opId           String
  visa           Json
  signature      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, opId])
  @@map("payment_visa")
}

model WorkerLease {
  name      String   @id
  holder    String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@map("worker_lease")
}

model PolicySnapshot {
  organizationId  String
  version         BigInt
  registryVersion BigInt
  status          String
  document        Json
  contentHash     String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@id([organizationId, version])
  @@unique([organizationId, contentHash])
  @@map("policy_snapshot")
}

model Operation {
  organizationId          String
  opId                    String
  agentId                 String
  reference               String
  state                   String
  txDigest                String
  evmNonce                BigInt
  amount                  Decimal      @db.Decimal(78, 0)
  visaNonce               BigInt?
  reportNonce             BigInt?
  txHash                  String?
  cancellationTxHash      String?
  nearAuthorizationTxHash String?
  nearCancellationTxHash  String?
  receiptBlock            BigInt?
  broadcastAt             DateTime?
  cancellationRequestedAt DateTime?
  cancellationBroadcastAt DateTime?
  revertedAt              DateTime?
  lastAttemptAt           DateTime?
  nextAttemptAt           DateTime?
  attempts                Int          @default(0)
  lastError               String?
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent                   Agent        @relation(fields: [agentId], references: [id], onDelete: Restrict)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@id([organizationId, opId])
  @@unique([organizationId, visaNonce])
  @@unique([organizationId, reportNonce])
  @@index([organizationId, reference])
  @@index([state, nextAttemptAt])
  @@map("operation")
}

model GovernanceOperation {
  organizationId        String
  opId                  String
  treasuryId            String
  relayAccountId        String
  clientId              String
  proposalId            Int?
  nearExecutionTxHash   String?
  nearExecutionSignerId String?
  state                 String
  finalStatus           String?
  target                String
  value                 String
  data                  String
  operation             Int
  txHash                String?
  receiptBlock          BigInt?
  queueNonce            BigInt?
  queueCreatedAt        BigInt?
  cooldownSeconds       BigInt?
  expirationSeconds     BigInt?
  executeRawTransaction String?
  executeTxHash         String?
  executeReceiptBlock   BigInt?
  rolesVerification     Json?
  reportNonce           BigInt?
  broadcastAt           DateTime?
  queuedAt              DateTime?
  executedAt            DateTime?
  lastAttemptAt         DateTime?
  nextAttemptAt         DateTime?
  attempts              Int          @default(0)
  lastError             String?
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  treasury              Treasury     @relation(fields: [treasuryId], references: [id], onDelete: Cascade)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@id([organizationId, opId])
  @@index([state, nextAttemptAt])
  @@index([treasuryId, updatedAt])
  @@map("governance_operation")
}

model Treasury {
  id                   String                @id @default(uuid())
  organizationId       String
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environment          String                @default("uat")
  nearNetwork          String
  baseChainId          Int
  daoAccountId         String
  vaultAccountId       String
  relayAccountId       String
  safeAddress          String
  rolesAddress         String
  delayAddress         String
  govAddress           String
  vaultWasmSha256      String
  relayWasmSha256      String
  status               String                @default("active")
  governanceOperations GovernanceOperation[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([organizationId, environment])
  @@index([organizationId])
  @@map("treasury")
}

model NearWalletSponsorship {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nearAccountId  String       @unique
  publicKey      String       @unique
  status         String       @default("reserved")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([createdAt, status])
  @@index([organizationId, userId])
  @@map("near_wallet_sponsorship")
}

model AgentProvisioning {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId         String       @unique
  agent           Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  nearAccountId   String       @unique
  publicKey       String       @unique
  vaultAccountId  String
  methodNames     Json
  reserveYocto    String
  allowanceYocto  String?
  status          String       @default("reserved")
  transactionHash String?
  confirmedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([createdAt, status])
  @@index([organizationId])
  @@map("agent_provisioning")
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorType      String
  actorId        String
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([actorType, actorId])
  @@map("audit_log")
}
