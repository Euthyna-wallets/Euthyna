{
  "name": "@mandateos/deployer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy:base-sepolia": "forge build --root . && tsx src/base-sepolia.ts",
    "fund:omniroles": "tsx src/fund-omniroles-wallet.ts",
    "bridge:omniroles-gas": "tsx src/bridge-omniroles-gas.ts",
    "update:researcher": "tsx src/update-researcher.ts",
    "configure:governance": "tsx src/configure-governance.ts",
    "veto:delay": "tsx src/veto-delay.ts",
    "verify:step3": "tsx src/verify-step3.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@gnosis-guild/zodiac-core": "4.3.0",
    "@safe-global/safe-deployments": "1.37.64",
    "viem": "^2.30.6",
    "zod": "^3.25.57",
    "zodiac-roles-sdk": "4.1.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
