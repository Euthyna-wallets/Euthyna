{
  email admin@euthyna.io
}

euthyna.io {
  encode zstd gzip

  handle /near-rpc {
    rewrite * /v1/console/near-rpc
    reverse_proxy api:3000
  }

  handle /api/* {
    reverse_proxy api:3000
  }

  handle /v1/* {
    reverse_proxy api:3000
  }

  handle /health {
    reverse_proxy api:3000
  }

  # Euthyna Market: x402 discovery and A2A endpoints are served by the API.
  handle /.well-known/* {
    reverse_proxy api:3000
  }

  handle /a2a/* {
    reverse_proxy api:3000
  }

  # ---- Until the reveal on 13 November 2026 ----------------------------------------------
  # The public sees only /teaser.html and the images it uses. The team opens
  # https://euthyna.io/enter/<PREVIEW_KEY> once: it sets a cookie and the whole site and app work
  # as usual. The API routes above stay open (agents, MCP, Market, sign-in).
  # PREVIEW_KEY comes from the server's .env (see docker-compose.server.yml).
  # To reveal: delete this block and the two "handle" blocks below it marked "teaser", reload.
  handle /enter/{$PREVIEW_KEY} {
    header Set-Cookie "euthyna_preview={$PREVIEW_KEY}; Path=/; Max-Age=2592000; Secure; HttpOnly; SameSite=Lax"
    redir / 302
  }

  @team header_regexp Cookie `(^|;\s*)euthyna_preview={$PREVIEW_KEY}(;|$)`
  handle @team {
    root * /srv
    # Built files carry a hash in their name: cache them for good. Everything else,
    # index.html first, is revalidated on every visit so a returning visitor never
    # gets the previous design from cache.
    @hashed path /assets/*
    header @hashed Cache-Control "public, max-age=31536000, immutable"
    @fresh not path /assets/*
    header @fresh Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
  }

  # teaser: the images the teaser page uses
  handle /media/* {
    root * /srv
    header Cache-Control "no-cache"
    file_server
  }

  # teaser: every other path, for everyone without the team cookie
  handle {
    root * /srv
    header Cache-Control "no-cache"
    rewrite * /teaser.html
    file_server
  }
  # ---- end of the reveal block -------------------------------------------------------------
}

www.euthyna.io {
  redir https://euthyna.io{uri} permanent
}
